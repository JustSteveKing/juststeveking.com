---
import Layout from '@/layouts/Layout.astro';
import { PageHeader, Card, Badge, SectionLabel } from '@/components';
import { services as pageMeta } from '@/config/pages';
import { site } from '@/config';
import { servicesOfferings as offerings, servicesProcess as process } from '@/data/content';

const servicesSchema = {
	'@context': 'https://schema.org',
	'@type': 'ProfessionalService',
	name: `Consulting Services — ${site.author}`,
	url: `${site.url}/services`,
	description: pageMeta.description,
	provider: { '@type': 'Person', name: site.author, url: site.url },
};
---

<Layout {...pageMeta} jsonLd={servicesSchema}>
	<PageHeader
		prompt="$ cat services.md"
		title="Services"
		subtitle="Practical API consulting and engineering leadership support for SaaS teams. No retainers you don't need, no deliverables that gather dust."
	/>

	<section class="px-section py-section border-b border-edge" aria-label="Service offerings">
		<div class="grid gap-6 sm:grid-cols-2">
			{
				offerings.map((service) => (
					<Card as="article" class="flex flex-col overflow-hidden">
						<div class="px-4 md:px-6 py-5 border-b border-edge-weak bg-surface-weak">
							<p class="font-mono text-[11px] fg-weak mb-2" aria-hidden="true">
								{service.prompt}
							</p>
							<div class="flex items-center gap-2 flex-wrap">
								<h2 class="text-base font-bold fg-strong">{service.title}</h2>
								{service.badge && (
									<Badge variant="amber" class="text-[10px] px-1.5 py-0.5">
										{service.badge}
									</Badge>
								)}
							</div>
							<p class="mt-1 text-[13px] fg leading-snug">{service.tagline}</p>
						</div>

						<div class="flex flex-col flex-1 px-4 md:px-6 py-5 gap-5">
							<p class="text-sm fg leading-relaxed">{service.description}</p>

							<div>
								<p class="font-mono text-[10px] uppercase tracking-widest fg-accent font-semibold mb-2">
									Deliverables
								</p>
								<ul class="list-none p-0 m-0 flex flex-col gap-1.5">
									{service.deliverables.map((d) => (
										<li class="flex items-start gap-2 text-[13px] fg">
											<span class="font-mono fg-accent shrink-0 mt-px">›</span>
											<span>{d}</span>
										</li>
									))}
								</ul>
							</div>

							<div class="mt-auto pt-4 border-t border-edge-weak flex items-center justify-between gap-4 flex-wrap">
								<p class="text-[12px] fg-weak italic max-w-[32ch]">{service.goodFor}</p>
								<Badge class="text-[11px] px-2 py-1 shrink-0">{service.duration}</Badge>
							</div>
						</div>
					</Card>
				))
			}
		</div>
	</section>

	<section class="px-section py-section border-b border-edge" aria-label="How it works">
		<SectionLabel class="mb-6">How it works</SectionLabel>
		<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
			{
				process.map((step) => (
					<div class="flex flex-col gap-2">
						<span class="font-mono text-[28px] font-bold fg-accent leading-none">{step.step}</span>
						<h3 class="text-sm font-semibold fg-strong">{step.title}</h3>
						<p class="text-[13px] fg leading-relaxed">{step.desc}</p>
					</div>
				))
			}
		</div>
	</section>

	<section class="px-section py-section" aria-label="Get in touch">
		<h2 class="text-2xl font-bold tracking-tight fg-strong mb-3">Ready to get started?</h2>
		<p class="fg max-w-[52ch] leading-relaxed mb-8">
			Start with a free 30-minute discovery call. We'll work out what you need, whether there's a
			fit, and what the right shape of engagement looks like.
		</p>
		<div class="flex flex-wrap items-center gap-3">
			<a
				href="https://juststeveking.link"
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center gap-2 px-6 py-3 font-mono font-semibold text-sm rounded-lg bg-surface-strong fg-inverted no-underline transition-colors hover:opacity-90"
			>
				Book a discovery call
				<span aria-hidden="true">→</span>
			</a>
			<a
				href="/about"
				class="inline-flex items-center gap-2 px-6 py-3 font-mono font-semibold text-sm rounded-lg border border-edge fg-strong no-underline transition-colors hover:border-accent hover:fg-accent"
			>
				Learn more about me
			</a>
		</div>
	</section>

	<script is:inline>
		document.addEventListener('DOMContentLoaded', () => {
			document.querySelectorAll('a[href="https://juststeveking.link"]').forEach((el) => {
				el.addEventListener('click', () => {
					window.posthog?.capture('discovery_call_clicked', { location: 'services' });
				});
			});
		});
	</script>
</Layout>
