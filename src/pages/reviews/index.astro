---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import { PageHeader } from '@/components';
import { site, pages } from '@/config';
import { formatDate } from '@/utils/format';

const all = await getCollection('reviews');
const reviews = all.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const pageMeta = pages.reviews;

const reviewsSchema = {
	'@context': 'https://schema.org',
	'@type': 'Blog',
	name: `DX Reviews by ${site.author}`,
	url: `${site.url}/reviews`,
	description: pageMeta.description,
	author: { '@type': 'Person', name: site.author, url: site.url },
};
---

<Layout {...pageMeta} jsonLd={reviewsSchema}>
	<PageHeader
		prompt="$ gh review list --author juststeveking"
		title="Reviews"
		subtitle="In-depth DX reviews covering API design, documentation, community, and education."
	/>

	<section aria-label="Reviews">
		<ul class="list-none p-0 m-0" role="list">
			{
				reviews.map((review) => (
					<li class="border-b border-edge last:border-b-0">
						<div class="flex flex-col gap-2 px-section py-6 transition-colors hover:[background-color:var(--color-bg-weak)] sm:flex-row sm:justify-between sm:items-start sm:gap-6">
							<div class="flex flex-col gap-1.5 min-w-0">
								<a
									href={`/reviews/${review.id}`}
									class="text-[15px] font-medium fg-strong leading-snug no-underline transition-colors hover:[color:var(--color-accent)]"
								>
									{review.data.title}
								</a>
								<span class="text-[13px] fg leading-snug line-clamp-2">
									{review.data.description}
								</span>
							</div>
							<div class="flex flex-row items-center gap-1.5 shrink-0 sm:flex-col sm:items-end">
								<span class="font-mono text-[11px] fg-accent uppercase tracking-[0.06em] font-semibold whitespace-nowrap">
									{review.data.badge}
								</span>
								<time
									class="font-mono text-[12px] fg-weak whitespace-nowrap"
									datetime={review.data.pubDate.toISOString()}
								>
									{formatDate(review.data.pubDate)}
								</time>
							</div>
						</div>
					</li>
				))
			}
		</ul>
	</section>
</Layout>
