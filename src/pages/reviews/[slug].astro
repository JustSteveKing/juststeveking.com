---
import { getCollection, render } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import { Breadcrumb, Tag } from '@/components';
import { site } from '@/config';
import { formatDate } from '@/utils/format';

export async function getStaticPaths() {
	const reviews = await getCollection('reviews');
	return reviews.map(review => ({
		params: { slug: review.id },
		props: { review },
	}));
}

const { review } = Astro.props;
const { Content } = await render(review);

const { title, description, pubDate, updatedDate, subject, subjectUrl, badge, tags } = review.data;

const pageUrl = `${site.url}/reviews/${review.id}`;

const pageMeta = {
	title,
	description,
	ogImage: `/og/reviews/${review.id}.webp`,
	canonicalUrl: pageUrl,
};

const reviewSchema = {
	'@context': 'https://schema.org',
	'@type': 'Review',
	name: title,
	description,
	datePublished: pubDate.toISOString(),
	dateModified: (updatedDate ?? pubDate).toISOString(),
	url: pageUrl,
	author: { '@type': 'Person', name: site.author, url: site.url },
	itemReviewed: {
		'@type': 'SoftwareApplication',
		name: subject,
		...(subjectUrl ? { url: subjectUrl } : {}),
	},
};
---

<Layout {...pageMeta} jsonLd={reviewSchema}>
	<article>
		<header class="px-section pt-12 pb-10 border-b border-edge">
			<Breadcrumb items={[
				{ label: 'Reviews', href: '/reviews' },
				{ label: subject },
			]} />

			<h1 class="text-[28px] font-bold fg-strong leading-tight mb-4 max-w-[60ch]">{title}</h1>
			<p class="text-base leading-[1.65] fg max-w-[60ch] mb-5">{description}</p>

			<div class="flex items-center gap-3.5 flex-wrap mb-4">
				<time class="font-mono text-[13px] fg-weak" datetime={pubDate.toISOString()}>
					{formatDate(pubDate)}
				</time>
				<span class="font-mono text-[11px] font-bold fg-accent uppercase tracking-[0.08em] border border-edge rounded-[3px] px-1.5 py-0.5" style="border-color: var(--color-accent);">{badge}</span>
				{subjectUrl && (
					<a
						href={subjectUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="font-mono text-[12px] fg-weak no-underline transition-colors hover:text-accent"
					>
						{subject} <span aria-hidden="true">↗</span>
						<span class="visually-hidden">(opens in new tab)</span>
					</a>
				)}
			</div>

			{tags.length > 0 && (
				<div class="flex flex-wrap gap-1.5" aria-label="Tags">
					{tags.map(tag => (
						<Tag>{tag}</Tag>
					))}
				</div>
			)}
		</header>

		<Content />
	</article>
</Layout>
