---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import { SiteHeader, SiteFooter } from '@/components';
import ApiDiagnostic from '@/components/ApiDiagnostic.svelte';
import { home as pageMeta } from '@/config/pages';
import { site } from '@/config';
import {
	heroContent,
	whatContent,
	features,
	tuiVisual,
} from '@/data/content';

const allTestimonials = await getCollection('testimonials');
const testimonials = allTestimonials.slice(0, 4);

const homeSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: site.name,
	url: site.url,
	description: pageMeta.description,
	author: {
		'@type': 'Person',
		name: site.author,
		url: site.url,
	},
};


// Build tui visual HTML from structured JSON data
const tuiLines = [
	`<span class="tui-visual-dim">$</span> ${tuiVisual.command}`,
	'',
	`  ${tuiVisual.scanning}`,
	'',
	...tuiVisual.results.map(r =>
		`  <span class="tui-visual-dim">●</span> ${r.method.padEnd(7)} <span class="tui-visual-strong">${r.path.padEnd(22)}</span> <span class="tui-visual-dim">${r.detail.padEnd(13)}</span> [${r.status}]`
	),
	'',
	`  <span class="tui-visual-green">${tuiVisual.summary}</span>`,
].join('\n');
---

<Layout {...pageMeta} jsonLd={homeSchema}>
	<main id="main-content" class="landing">
		<div class="landing-container">

			<SiteHeader />

			<!-- Hero -->
			<section class="hero" aria-labelledby="hero-heading">
				<div class="hero-content">
					<div class="hero-copy">
						<h1 id="hero-heading">{heroContent.heading}</h1>
						<p class="hero-subtitle">{heroContent.subheading}</p>
					</div>
				</div>
			</section>

			<!-- API Diagnostic -->
			<section aria-label="API diagnostic preview">
				<ApiDiagnostic client:load />
			</section>

			<!-- How I help -->
			<section class="what-section" aria-labelledby="what-heading">
				<div class="what-section-title">
					<h2 id="what-heading">{whatContent.heading}</h2>
					<p>{whatContent.body}</p>
				</div>

				<div class="features-split">
					<div class="features-list">
						<ul class="what-list" aria-label="How I help">
							{features.map((feature, i) => (
								<li>
									<button
										class={`feature-item ${i === 0 ? 'active' : ''}`}
										data-feature={feature.type}
										aria-pressed={i === 0 ? 'true' : 'false'}
									>
										<span class="bullet" aria-hidden="true">{i === 0 ? '[o]' : '[*]'}</span>
										<div>
											<strong>{feature.title}</strong> {feature.description}
										</div>
									</button>
								</li>
							))}
						</ul>

						<div class="what-actions">
							<a href={heroContent.cta.href} class="btn-dark">
								<span>{heroContent.cta.label}</span>
								<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
									<path d="M6.5 12L17 12M13 16.5L17.5 12L13 7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"></path>
								</svg>
							</a>
						</div>
					</div>

					<div class="features-visual" aria-hidden="true">
						<div class="tui-visual-container">
							<div class="tui-visual-header">
								<span class="tui-visual-dot"></span>
								<span class="tui-visual-dot"></span>
								<span class="tui-visual-dot"></span>
							</div>
							<div class="tui-visual-body" set:html={tuiLines}></div>
						</div>
					</div>
				</div>
			</section>

			<!-- Stats -->
			<section class="px-section py-16 border-b border-edge" aria-label="Why teams trust me">
				<p class="font-mono text-[11px] uppercase tracking-[0.1em] fg-weak mb-10">Why teams trust me</p>
				<div class="grid gap-8 sm:grid-cols-3">
					{[
						{ value: '15+', label: 'years solving messy software problems', detail: 'From frontline systems thinking to leading engineering teams under real delivery pressure.' },
						{ value: '50K+', label: 'developers reached through articles and education', detail: 'Authority built on practical writing, talks, and hands-on delivery work.' },
						{ value: '30+', label: 'talks and workshops delivered internationally', detail: 'Helping teams make better API, architecture, and enablement decisions.' },
					].map(stat => (
						<div class="flex flex-col gap-3 p-8 rounded-2xl border border-edge bg-surface">
							<span class="font-mono text-[48px] font-bold fg-accent leading-none">{stat.value}</span>
							<p class="text-[15px] font-semibold fg-strong leading-snug">{stat.label}</p>
							<p class="text-[14px] fg leading-relaxed">{stat.detail}</p>
						</div>
					))}
				</div>
			</section>

			<!-- Problems -->
			<section class="px-section py-16 border-b border-edge" aria-label="Common API problems">
				<div class="max-w-[56ch] mb-12">
					<h2 class="font-mono text-[24px] font-bold fg-strong leading-snug mb-4">Your API is probably slowing the team down in more ways than one.</h2>
					<p class="text-[16px] fg leading-relaxed">When the platform is unreliable, the damage is not just technical. Engineers lose confidence, product work slows down, and delivery becomes dominated by caution and context switching.</p>
				</div>
				<div class="grid gap-6 sm:grid-cols-3">
					{[
						{ prompt: '$ tail -f /var/log/incidents', title: 'You\'re firefighting instead of building', desc: 'Latency spikes, brittle integrations, and unclear ownership keep dragging engineers back into incident mode.' },
						{ prompt: '$ git log --grep="hotfix"', title: 'Your team doesn\'t trust the system', desc: 'Every release feels risky because API behaviour is inconsistent, debugging is slow, and the root causes stay murky.' },
						{ prompt: '$ estimate --scope=rewrite', title: 'The rewrite feels bigger than the fix', desc: 'You know the platform needs attention, but replacing everything would slow delivery even more.' },
					].map(problem => (
						<div class="flex flex-col gap-4 p-8 rounded-2xl border border-edge bg-surface">
							<p class="font-mono text-[11px] fg-weak" aria-hidden="true">{problem.prompt}</p>
							<h3 class="text-[16px] font-semibold fg-strong leading-snug">{problem.title}</h3>
							<p class="text-[15px] fg leading-relaxed">{problem.desc}</p>
						</div>
					))}
				</div>
			</section>

			<!-- Framework -->
			<section class="px-section py-16 border-b border-edge" aria-label="API Stability Framework">
				<div class="max-w-[56ch] mb-12">
					<p class="font-mono text-[11px] uppercase tracking-[0.1em] fg-weak mb-4">How I work</p>
					<h2 class="font-mono text-[24px] font-bold fg-strong leading-snug mb-4">An API Stability Framework built around diagnose, stabilise, and scale.</h2>
					<p class="text-[16px] fg leading-relaxed">The goal is not consulting theatre. Get clear on what is actually broken, fix the highest-leverage issues first, and leave the team with better habits than it had before.</p>
				</div>
				<div class="grid gap-8 sm:grid-cols-3">
					{[
						{ step: '01', title: 'Diagnose', desc: 'Map the hotspots, instrumentation gaps, and reliability failures that are actually costing you time.' },
						{ step: '02', title: 'Stabilise', desc: 'Fix the riskiest endpoints, contracts, and operational bottlenecks first so the team can breathe again.' },
						{ step: '03', title: 'Scale', desc: 'Leave behind patterns, guardrails, and decision-making habits the team can keep using without me in the room.' },
					].map(item => (
						<div class="flex flex-col gap-4">
							<span class="font-mono text-[32px] font-bold fg-accent leading-none">{item.step}</span>
							<h3 class="text-[17px] font-semibold fg-strong">{item.title}</h3>
							<p class="text-[15px] fg leading-relaxed">{item.desc}</p>
						</div>
					))}
				</div>
				<div class="mt-10">
					<a href="/services" class="font-mono text-[14px] fg-accent no-underline hover:underline">See how the work is structured →</a>
				</div>
			</section>

			<!-- Testimonials -->
			<section class="px-section py-16 border-b border-edge" aria-label="Testimonials">
				<p class="font-mono text-[11px] uppercase tracking-[0.1em] fg-weak mb-10">Trusted by teams</p>
				<div class="grid gap-6 sm:grid-cols-2">
					{testimonials.map(t => (
						<figure class="flex flex-col gap-5 p-8 rounded-2xl border border-edge bg-surface">
							<blockquote class="text-[16px] fg leading-relaxed m-0 flex-1">
								<p>"{t.data.quote}"</p>
							</blockquote>
							<figcaption class="flex items-center gap-3">
								{t.data.author.avatar && (
									<img
										src={t.data.author.avatar.src}
										alt=""
										width="40"
										height="40"
										class="rounded-full w-10 h-10 object-cover shrink-0"
										loading="lazy"
									/>
								)}
								<div>
									<p class="text-[14px] font-semibold fg-strong leading-none mb-1">{t.data.author.name}</p>
									<p class="font-mono text-[12px] fg-weak">{t.data.author.role}, {t.data.author.company}</p>
								</div>
							</figcaption>
						</figure>
					))}
				</div>
			</section>

			<!-- Services preview -->
			<section class="px-section py-16 border-b border-edge" aria-label="Services">
				<div class="flex items-end justify-between gap-4 flex-wrap mb-12">
					<div class="max-w-[44ch]">
						<p class="font-mono text-[11px] uppercase tracking-[0.1em] fg-weak mb-4">Three ways to work together</p>
						<h2 class="font-mono text-[24px] font-bold fg-strong leading-snug">Without bloated consulting packages.</h2>
					</div>
					<a href="/services" class="font-mono text-[14px] fg-accent no-underline hover:underline shrink-0">View all services →</a>
				</div>
				<div class="grid gap-6 sm:grid-cols-3">
					{[
						{ prompt: '$ analyze --scope=full', title: 'API Audit', desc: 'A focused investigation into the performance, reliability, and design issues slowing your team down.', benefit: 'Clear action plan, prioritised fixes, faster route to stability.' },
						{ prompt: '$ fix --priority=high', title: 'Performance & Reliability Fixes', desc: 'Hands-on work to remove bottlenecks, reduce avoidable incidents, and make delivery feel calmer.', benefit: 'Meaningful improvements without a costly full rewrite.' },
						{ prompt: '$ gh team --advise', title: 'Ongoing Advisory', desc: 'Strategic technical support for leaders and senior engineers making difficult API and architecture decisions.', benefit: 'Sharper technical calls, stronger standards, trusted perspective.' },
					].map(service => (
						<div class="flex flex-col gap-4 p-8 rounded-2xl border border-edge bg-surface">
							<p class="font-mono text-[11px] fg-weak" aria-hidden="true">{service.prompt}</p>
							<h3 class="text-[16px] font-semibold fg-strong">{service.title}</h3>
							<p class="text-[15px] fg leading-relaxed flex-1">{service.desc}</p>
							<p class="text-[13px] fg-weak italic border-t border-edge-weak pt-4 mt-auto">{service.benefit}</p>
						</div>
					))}
				</div>
			</section>

			<!-- Final CTA -->
			<section class="px-section py-20" aria-label="Get started">
				<div class="max-w-[52ch]">
					<h2 class="font-mono text-[28px] font-bold fg-strong leading-snug mb-5">Ready to stop losing time to API instability?</h2>
					<p class="text-[16px] fg leading-relaxed mb-10">
						Send a little context on the team, the symptoms, and what good looks like. I'll tell you whether an audit, a fix sprint, or ongoing advisory is the right next step.
					</p>
					<div class="flex flex-wrap items-center gap-4">
						<a
							href="https://juststeveking.link"
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center gap-2 px-6 py-3 font-mono font-semibold text-sm rounded-lg bg-surface-weak fg-inverted no-underline transition-colors hover:opacity-90"
						>
							Book a call
							<span aria-hidden="true">→</span>
							<span class="visually-hidden">(opens in new tab)</span>
						</a>
						<a
							href="/services"
							class="inline-flex items-center gap-2 px-6 py-3 font-mono font-semibold text-sm rounded-lg border border-edge fg-strong no-underline transition-colors hover:border-accent hover:fg-accent"
						>
							See the offers
						</a>
					</div>
				</div>
			</section>

			<SiteFooter />
		</div>
	</main>

	<script>
		const featureItems = document.querySelectorAll<HTMLElement>('.feature-item');
		featureItems.forEach(item => {
			const activate = () => {
				featureItems.forEach(i => {
					i.classList.remove('active');
					i.setAttribute('aria-pressed', 'false');
					const bull = i.querySelector('.bullet');
					if (bull) bull.textContent = '[*]';
				});
				item.classList.add('active');
				item.setAttribute('aria-pressed', 'true');
				const bull = item.querySelector('.bullet');
				if (bull) bull.textContent = '[o]';
			};
			item.addEventListener('click', activate);
			item.addEventListener('keydown', (e: KeyboardEvent) => {
				if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); activate(); }
			});
		});
	</script>
</Layout>
