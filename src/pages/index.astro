---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import ApiDiagnostic from '@/components/ApiDiagnostic.svelte';
import Card from '@/components/Card.astro';
import SectionLabel from '@/components/SectionLabel.astro';
import { home as pageMeta } from '@/config/pages';
import { site } from '@/config';
import {
	heroContent,
	whatContent,
	features,
	homeStats as stats,
	homeProblems as problems,
	homeFramework as framework,
	homeServicesPreview as servicesPreview,
	homeFinalCta as finalCta,
} from '@/data/content';

const allTestimonials = await getCollection('testimonials');
const testimonials = allTestimonials.slice(0, 4);

const homeSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: site.name,
	url: site.url,
	description: pageMeta.description,
	author: {
		'@type': 'Person',
		name: site.author,
		url: site.url,
	},
};


// Build tui visual HTML from structured JSON data
const initialVisual = features[0].visual;
const tuiLines = [
	`<span class="tui-visual-dim">$</span> ${initialVisual.command}`,
	'',
	`  ${initialVisual.scanning}`,
	'',
	...initialVisual.results.map(r =>
		`  <span class="tui-visual-dim">●</span> ${r.method.padEnd(7)} <span class="tui-visual-strong">${r.path.padEnd(22)}</span> <span class="tui-visual-dim">${r.detail.padEnd(13)}</span> [${r.status}]`
	),
	'',
	`  <span class="tui-visual-green">${initialVisual.summary}</span>`,
].join('\n');
---

<Layout {...pageMeta} jsonLd={homeSchema}>
			<!-- Hero -->
			<section class="hero" aria-labelledby="hero-heading">
				<div class="hero-content">
					<div class="hero-copy">
						<h1 id="hero-heading">{heroContent.heading}</h1>
						<p class="hero-subtitle">{heroContent.subheading}</p>
					</div>
				</div>
			</section>

			<!-- API Diagnostic -->
			<section aria-label="API diagnostic preview">
				<ApiDiagnostic client:load />
			</section>

			<!-- How I help -->
			<section class="what-section" aria-labelledby="what-heading">
				<div class="what-section-title">
					<h2 id="what-heading">{whatContent.heading}</h2>
					<p>{whatContent.body}</p>
				</div>

				<div class="features-split">
					<div class="features-list">
						<ul class="what-list" aria-label="How I help">
							{features.map((feature, i) => (
								<li>
									<button
										class={`feature-item ${i === 0 ? 'active' : ''}`}
										data-feature={feature.type}
										aria-pressed={i === 0 ? 'true' : 'false'}
									>
										<span class="bullet" aria-hidden="true">{i === 0 ? '[o]' : '[*]'}</span>
										<div>
											<strong>{feature.title}</strong> {feature.description}
										</div>
									</button>
								</li>
							))}
						</ul>

						<div class="what-actions">
							<a href={heroContent.cta.href} class="btn-dark">
								<span>{heroContent.cta.label}</span>
								<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
									<path d="M6.5 12L17 12M13 16.5L17.5 12L13 7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"></path>
								</svg>
							</a>
						</div>
					</div>

					<div class="features-visual" aria-hidden="true">
						<div class="tui-visual-container">
							<div class="tui-visual-header">
								<span class="tui-visual-dot"></span>
								<span class="tui-visual-dot"></span>
								<span class="tui-visual-dot"></span>
							</div>
							<div class="tui-visual-body" set:html={tuiLines}></div>
						</div>
					</div>
				</div>
			</section>

			<!-- Stats -->
			<section class="px-section py-section border-b border-edge" aria-label={stats.tagline}>
				<SectionLabel class="mb-10">{stats.tagline}</SectionLabel>
				<div class="grid gap-8 sm:grid-cols-3">
					{stats.items.map(stat => (
						<Card class="flex flex-col gap-3 p-8">
							<span class="font-mono text-[48px] font-bold fg-accent leading-none">{stat.value}</span>
							<p class="text-[15px] font-semibold fg-strong leading-snug">{stat.label}</p>
							<p class="text-[14px] fg leading-relaxed">{stat.detail}</p>
						</Card>
					))}
				</div>
			</section>

			<!-- Problems -->
			<section class="px-section py-section border-b border-edge" aria-label="Common API problems">
				<div class="max-w-[56ch] mb-12">
					<h2 class="font-mono text-[24px] font-bold fg-strong leading-snug mb-4">{problems.title}</h2>
					<p class="text-[16px] fg leading-relaxed">{problems.description}</p>
				</div>
				<div class="grid gap-6 sm:grid-cols-3">
					{problems.items.map(problem => (
						<Card class="flex flex-col gap-4 p-8">
							<p class="font-mono text-[11px] fg-weak" aria-hidden="true">{problem.prompt}</p>
							<h3 class="text-[16px] font-semibold fg-strong leading-snug">{problem.title}</h3>
							<p class="text-[15px] fg leading-relaxed">{problem.desc}</p>
						</Card>
					))}
				</div>
			</section>

			<!-- Framework -->
			<section class="px-section py-section border-b border-edge" aria-label="API Stability Framework">
				<div class="max-w-[56ch] mb-12">
					<SectionLabel class="mb-4">{framework.tagline}</SectionLabel>
					<h2 class="font-mono text-[24px] font-bold fg-strong leading-snug mb-4">{framework.title}</h2>
					<p class="text-[16px] fg leading-relaxed">{framework.description}</p>
				</div>
				<div class="grid gap-8 sm:grid-cols-3">
					{framework.items.map(item => (
						<div class="flex flex-col gap-4">
							<span class="font-mono text-[32px] font-bold fg-accent leading-none">{item.step}</span>
							<h3 class="text-[17px] font-semibold fg-strong">{item.title}</h3>
							<p class="text-[15px] fg leading-relaxed">{item.desc}</p>
						</div>
					))}
				</div>
				<div class="mt-10">
					<a href="/services" class="font-mono text-[14px] fg-accent no-underline hover:underline">See how the work is structured →</a>
				</div>
			</section>

			<!-- Testimonials -->
			<section class="px-section py-section border-b border-edge" aria-label="Testimonials">
				<SectionLabel class="mb-10">Trusted by teams</SectionLabel>
				<div class="grid gap-6 sm:grid-cols-2">
					{testimonials.map(t => (
						<Card as="figure" class="flex flex-col gap-5 p-8">
							<blockquote class="text-[16px] fg leading-relaxed m-0 flex-1">
								<p>"{t.data.quote}"</p>
							</blockquote>
							<figcaption class="flex items-center gap-3">
								{t.data.author.avatar && (
									<img
										src={t.data.author.avatar.src}
										alt=""
										width="40"
										height="40"
										class="rounded-full w-10 h-10 object-cover shrink-0"
										loading="lazy"
									/>
								)}
								<div>
									<p class="text-[14px] font-semibold fg-strong leading-none mb-1">{t.data.author.name}</p>
									<p class="font-mono text-[12px] fg-weak">{t.data.author.role}, {t.data.author.company}</p>
								</div>
							</figcaption>
						</Card>
					))}
				</div>
			</section>

			<!-- Services preview -->
			<section class="px-section py-section border-b border-edge" aria-label="Services">
				<div class="flex items-end justify-between gap-4 flex-wrap mb-12">
					<div class="max-w-[44ch]">
						<SectionLabel class="mb-4">{servicesPreview.tagline}</SectionLabel>
						<h2 class="font-mono text-[24px] font-bold fg-strong leading-snug">{servicesPreview.title}</h2>
					</div>
					<a href="/services" class="font-mono text-[14px] fg-accent no-underline hover:underline shrink-0">View all services →</a>
				</div>
				<div class="grid gap-6 sm:grid-cols-3">
					{servicesPreview.items.map(service => (
						<Card class="flex flex-col gap-4 p-8">
							<p class="font-mono text-[11px] fg-weak" aria-hidden="true">{service.prompt}</p>
							<h3 class="text-[16px] font-semibold fg-strong">{service.title}</h3>
							<p class="text-[15px] fg leading-relaxed flex-1">{service.desc}</p>
							<p class="text-[13px] fg-weak italic border-t border-edge-weak pt-4 mt-auto">{service.benefit}</p>
						</Card>
					))}
				</div>
			</section>

			<!-- Final CTA -->
			<section class="px-section py-section" aria-label="Get started">
				<div class="max-w-[52ch]">
					<h2 class="font-mono text-[28px] font-bold fg-strong leading-snug mb-5">{finalCta.title}</h2>
					<p class="text-[16px] fg leading-relaxed mb-10">
						{finalCta.description}
					</p>
					<div class="flex flex-wrap items-center gap-4">
						<a
							href="https://juststeveking.link"
							target="_blank"
							rel="noopener noreferrer"
							class="btn-dark"
						>
							Book a call
							<span aria-hidden="true">→</span>
							<span class="visually-hidden">(opens in new tab)</span>
						</a>
						<a
							href="/services"
							class="inline-flex items-center gap-2 px-6 py-3 font-mono font-semibold text-sm rounded-lg border border-edge fg-strong no-underline transition-colors hover:border-accent hover:fg-accent"
						>
							See the offers
						</a>
					</div>
				</div>
			</section>

	<script define:vars={{ features }}>
		const tuiBody = document.querySelector('.tui-visual-body');
		const featureItems = document.querySelectorAll('.feature-item');

		function buildTuiHtml(visual) {
			const results = visual.results.map(r =>
				`  <span class="tui-visual-dim">●</span> ${r.method.padEnd(7)} <span class="tui-visual-strong">${r.path.padEnd(22)}</span> <span class="tui-visual-dim">${r.detail.padEnd(13)}</span> [${r.status}]`
			).join('\n');

			return [
				`<span class="tui-visual-dim">$</span> ${visual.command}`,
				'',
				`  ${visual.scanning}`,
				'',
				results,
				'',
				`  <span class="tui-visual-green">${visual.summary}</span>`,
			].join('\n');
		}

		featureItems.forEach((item, index) => {
			const activate = () => {
				featureItems.forEach(i => {
					i.classList.remove('active');
					i.setAttribute('aria-pressed', 'false');
					const bull = i.querySelector('.bullet');
					if (bull) bull.textContent = '[*]';
				});
				item.classList.add('active');
				item.setAttribute('aria-pressed', 'true');
				const bull = item.querySelector('.bullet');
				if (bull) bull.textContent = '[o]';

				// Update TUI visual
				if (tuiBody && features[index] && features[index].visual) {
					tuiBody.innerHTML = buildTuiHtml(features[index].visual);
				}
			};
			item.addEventListener('click', activate);
			item.addEventListener('keydown', (e) => {
				if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); activate(); }
			});
		});
	</script>
</Layout>
