---
import { getCollection, render } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import { Breadcrumb, Tag } from '@/components';
import { site } from '@/config';
import { slugify } from '@/utils/articles';
import { formatDate } from '@/utils/format';

export async function getStaticPaths() {
	const articles = await getCollection('articles', ({ data }) => !data.draft);
	return articles.map((article) => ({
		params: { slug: article.id },
		props: { article },
	}));
}

const { article } = Astro.props;
const { Content } = await render(article);

const { title, description, pubDate, updatedDate, category, tags, minRead, image, canonical } =
	article.data;

const pageUrl = `${site.url}/articles/${article.id}`;

const pageMeta = {
	title,
	description,
	ogImage: image ?? `/og/articles/${article.id}.webp`,
	canonicalUrl: canonical ?? pageUrl,
};

const articleSchema = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description,
	datePublished: pubDate.toISOString(),
	dateModified: (updatedDate ?? pubDate).toISOString(),
	url: pageUrl,
	image: image ?? `${site.url}/og-image.png`,
	author: { '@type': 'Person', name: site.author, url: site.url },
	publisher: { '@type': 'Person', name: site.author, url: site.url },
	keywords: tags.join(', '),
	articleSection: category,
	...(minRead ? { timeRequired: `PT${minRead}M` } : {}),
};
---

<Layout {...pageMeta} jsonLd={articleSchema}>
	<article>
		<header class="px-section py-section border-b border-edge">
			<Breadcrumb
				items={[
					{ label: 'Articles', href: '/articles' },
					{ label: category, href: `/articles/category/${slugify(category)}` },
				]}
			/>

			<h1 class="text-[28px] sm:text-[28px] font-bold fg-strong leading-tight mb-4 max-w-[60ch]">
				{title}
			</h1>
			<p class="text-base leading-[1.65] fg max-w-[60ch] mb-5">{description}</p>

			<div class="flex items-center gap-3.5 flex-wrap mb-4">
				<time class="font-mono text-[13px] fg-weak" datetime={pubDate.toISOString()}>
					{formatDate(pubDate)}
				</time>
				{
					minRead && (
						<span class="font-mono text-[11px] fg-weak border border-edge rounded-[3px] px-1.5 py-px">
							{minRead} min read
						</span>
					)
				}
				<span class="font-mono text-[11px] fg-accent uppercase tracking-[0.06em] font-semibold"
					>{category}</span
				>
			</div>

			{
				tags.length > 0 && (
					<div class="flex flex-wrap gap-1.5" aria-label="Tags">
						{tags.map((tag) => (
							<Tag href={`/articles/tag/${slugify(tag)}`}>{tag}</Tag>
						))}
					</div>
				)
			}
		</header>

		<div class="px-section py-section pb-16 prose prose-xl">
			<Content />
		</div>
	</article>

	<!-- Post-article CTA -->
	<section class="px-section py-section border-t border-edge" aria-label="Work with me">
		<p class="font-mono text-[11px] uppercase tracking-widest fg-weak mb-4">Work with me</p>
		<p class="text-[16px] fg leading-relaxed max-w-[52ch] mb-6">
			If your team is dealing with slow or unreliable APIs, I offer focused audits, hands-on fixes,
			and ongoing advisory. Start with a free discovery call.
		</p>
		<div class="flex flex-wrap items-center gap-3">
			<a
				href="https://juststeveking.link"
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center gap-2 px-5 py-2.5 font-mono font-semibold text-sm rounded-lg bg-surface-strong fg-inverted no-underline transition-colors hover:opacity-90"
			>
				Book a discovery call <span aria-hidden="true">→</span>
				<span class="visually-hidden">(opens in new tab)</span>
			</a>
			<a href="/services" class="font-mono text-[13px] fg-accent no-underline hover:underline">
				See all services
			</a>
		</div>
	</section>

	<script is:inline define:vars={{ title, category, tags, minRead }}>
		document.addEventListener('DOMContentLoaded', () => {
			window.posthog?.capture('article_read', {
				article_title: title,
				article_category: category,
				article_tags: tags,
				article_min_read: minRead ?? null,
			});

			document.querySelectorAll('a[href="https://juststeveking.link"]').forEach((el) => {
				el.addEventListener('click', () => {
					window.posthog?.capture('discovery_call_clicked', {
						location: 'article',
						article_title: title,
					});
				});
			});
		});
	</script>
</Layout>
