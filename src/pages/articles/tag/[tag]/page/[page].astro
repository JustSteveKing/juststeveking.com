---
import type { GetStaticPathsResult } from 'astro';
import Layout from '@/layouts/Layout.astro';
import { SiteHeader, SiteFooter, PageHeader, Breadcrumb } from '@/components';
import { ArticleList, ArticlePagination } from '@/components/articles';
import { site } from '@/config';
import { getAllArticles, getAllTags, slugify, PAGE_SIZE } from '@/utils/articles';

export async function getStaticPaths(): Promise<GetStaticPathsResult> {
	const tags = await getAllTags();
	const allArticles = await getAllArticles();
	const paths = [];

	for (const tag of tags) {
		const slug = slugify(tag);
		const articles = allArticles.filter(a => a.data.tags.some(t => slugify(t) === slug));
		const totalPages = Math.ceil(articles.length / PAGE_SIZE);

		for (let pageNum = 2; pageNum <= totalPages; pageNum++) {
			const start = (pageNum - 1) * PAGE_SIZE;
			paths.push({
				params: { tag: slug, page: String(pageNum) },
				props: {
					tagName: tag,
					articles: articles.slice(start, start + PAGE_SIZE),
					currentPage: pageNum,
					totalPages,
					total: articles.length,
				},
			});
		}
	}

	return paths;
}

interface Props {
	tagName: string;
	articles: Awaited<ReturnType<typeof getAllArticles>>;
	currentPage: number;
	totalPages: number;
	total: number;
}

const { tagName, articles, currentPage, totalPages, total } = Astro.props;
const { tag } = Astro.params;

const prevHref = currentPage === 2
	? `/articles/tag/${tag}`
	: `/articles/tag/${tag}/page/${currentPage - 1}`;
const nextHref = currentPage < totalPages
	? `/articles/tag/${tag}/page/${currentPage + 1}`
	: null;

const pageMeta = {
	title: `#${tagName} — Articles — Page ${currentPage}`,
	description: `Articles tagged "${tagName}" by ${site.author}.`,
};

const tagSchema = {
	'@context': 'https://schema.org',
	'@type': 'Blog',
	name: `#${tagName} articles by ${site.author} — Page ${currentPage}`,
	url: `${site.url}/articles/tag/${tag}/page/${currentPage}`,
	description: pageMeta.description,
	author: { '@type': 'Person', name: site.author, url: site.url },
};
---

<Layout {...pageMeta} jsonLd={tagSchema}>
	<main id="main-content" class="landing">
		<div class="landing-container">
			<SiteHeader />

			<PageHeader
				prompt={`$ git tag -l '${tagName}'`}
				title={`#${tagName}`}
				subtitle={`${total} article${total === 1 ? '' : 's'} with this tag`}
			/>

			<Breadcrumb variant="filter" items={[
				{ label: 'All articles', href: '/articles' },
				{ label: `#${tagName}`, href: `/articles/tag/${tag}` },
			]} />

			<section aria-label={`Articles tagged ${tagName}`}>
				<ArticleList articles={articles} />
			</section>

			<ArticlePagination
				currentPage={currentPage}
				totalPages={totalPages}
				total={total}
				prevHref={prevHref}
				nextHref={nextHref}
			/>

			<SiteFooter />
		</div>
	</main>
</Layout>
