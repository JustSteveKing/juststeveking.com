---
import Layout from '@/layouts/Layout.astro';
import { PageHeader } from '@/components';
import { ArticleList, ArticlePagination } from '@/components/articles';
import { articles as pageMeta } from '@/config/pages';
import { site } from '@/config';
import { blogMeta } from '@/data/content';
import { getAllArticles, PAGE_SIZE } from '@/utils/articles';

const sorted = await getAllArticles();
const page = sorted.slice(0, PAGE_SIZE);
const totalPages = Math.ceil(sorted.length / PAGE_SIZE);

const nextHref = totalPages > 1 ? '/articles/page/2' : null;

const articlesSchema = {
	'@context': 'https://schema.org',
	'@type': 'Blog',
	name: `Articles by ${site.author}`,
	url: `${site.url}/articles`,
	description: pageMeta.description,
	author: { '@type': 'Person', name: site.author, url: site.url },
	blogPost: page.map(article => ({
		'@type': 'BlogPosting',
		headline: article.data.title,
		description: article.data.description,
		datePublished: article.data.pubDate.toISOString(),
		url: `${site.url}/articles/${article.id}`,
		author: { '@type': 'Person', name: site.author, url: site.url },
	})),
};
---

<Layout {...pageMeta} jsonLd={articlesSchema}>
	<PageHeader
		prompt={blogMeta.prompt}
		title={blogMeta.title}
		subtitle={blogMeta.subtitle}
	/>

	<section aria-label="Articles">
		<ArticleList articles={page} />
	</section>

	<ArticlePagination
		currentPage={1}
		totalPages={totalPages}
		total={sorted.length}
		prevHref={null}
		nextHref={nextHref}
	/>
</Layout>
