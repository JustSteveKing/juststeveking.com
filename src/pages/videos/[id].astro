---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import { SiteHeader, SiteFooter, Breadcrumb, Tag } from '@/components';
import { site } from '@/config';
import { formatDate } from '@/utils/format';

export async function getStaticPaths() {
	const videos = await getCollection('videos');
	return videos.map(video => ({
		params: { id: video.id },
		props: { video },
	}));
}

const { video } = Astro.props;
const { title, description, videoId, publishedDate, duration, views, type, tags, difficulty } = video.data;

const typeLabels: Record<string, string> = {
	video: 'Video',
	shorts: 'Short',
	livestream: 'Livestream',
};

const pageUrl = `${site.url}/videos/${video.id}`;
const ytUrl = `https://www.youtube.com/watch?v=${videoId}`;

const videoSchema = {
	'@context': 'https://schema.org',
	'@type': 'VideoObject',
	name: title,
	description,
	url: pageUrl,
	embedUrl: `https://www.youtube.com/embed/${videoId}`,
	uploadDate: publishedDate.toISOString(),
	author: { '@type': 'Person', name: site.author, url: site.url },
	...(duration ? { duration: `PT${duration.replace(':', 'H').replace(':', 'M')}S` } : {}),
};
---

<Layout title={title} description={description} ogImage={`/og/videos/${video.id}.webp`} jsonLd={videoSchema}>
	<main id="main-content" class="landing">
		<div class="landing-container">
			<SiteHeader />

			<article>
				<header class="px-section pt-12 pb-10 border-b border-edge">
					<Breadcrumb items={[
						{ label: 'Videos', href: '/videos' },
						{ label: typeLabels[type] ?? type },
					]} />

					<h1 class="text-[28px] font-bold fg-strong leading-tight mb-4 max-w-[60ch]">{title}</h1>
					<p class="text-base leading-[1.65] fg max-w-[60ch] mb-5">{description}</p>

					<div class="flex items-center gap-[14px] flex-wrap mb-4">
						<time class="font-mono text-[13px] fg-weak" datetime={publishedDate.toISOString()}>
							{formatDate(publishedDate)}
						</time>
						<span class="font-mono text-[11px] fg-accent uppercase tracking-[0.06em] font-semibold">
							{typeLabels[type] ?? type}
						</span>
						{duration && (
							<span class="font-mono text-[11px] fg-weak border border-edge rounded-[3px] px-1.5 py-px">{duration}</span>
						)}
						{views && (
							<span class="font-mono text-[11px] fg-weak">{views} views</span>
						)}
						{difficulty && (
							<span class="font-mono text-[11px] fg-weak uppercase tracking-[0.06em]">{difficulty}</span>
						)}
					</div>

					{tags.length > 0 && (
						<div class="flex flex-wrap gap-1.5" aria-label="Tags">
							{tags.map(tag => (
								<Tag>{tag}</Tag>
							))}
						</div>
					)}
				</header>

				<div class="px-section py-10">
					<div class="relative w-full max-w-[72ch] rounded-xl overflow-hidden bg-surface-weak" style="aspect-ratio: 16/9;">
						<iframe
							src={`https://www.youtube-nocookie.com/embed/${videoId}`}
							title={title}
							allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
							allowfullscreen
							loading="lazy"
							class="absolute inset-0 w-full h-full border-0"
						></iframe>
					</div>

					<div class="mt-6 flex flex-wrap items-center gap-3">
						<a
							href={ytUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="font-mono text-[13px] fg-accent no-underline hover:underline"
						>
							Watch on YouTube <span aria-hidden="true">↗</span>
						<span class="visually-hidden">(opens in new tab)</span>
						</a>
						<a
							href="https://youtube.com/@juststeveking"
							target="_blank"
							rel="noopener noreferrer"
							class="font-mono text-[13px] fg-weak no-underline hover:underline"
						>
							Subscribe <span aria-hidden="true">↗</span>
							<span class="visually-hidden">(opens in new tab)</span>
						</a>
					</div>
				</div>
			</article>

			<section class="px-section py-12 border-t border-edge" aria-label="Work with me">
				<p class="font-mono text-[11px] uppercase tracking-[0.1em] fg-weak mb-4">Work with me</p>
				<p class="text-[16px] fg leading-relaxed max-w-[52ch] mb-6">
					If your team is dealing with slow or unreliable APIs, I offer focused audits, hands-on fixes, and ongoing advisory.
				</p>
				<div class="flex flex-wrap items-center gap-3">
					<a
						href="https://juststeveking.link"
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center gap-2 px-5 py-2.5 font-mono font-semibold text-sm rounded-lg bg-surface-strong fg-inverted no-underline transition-colors hover:opacity-90"
					>
						Book a discovery call <span aria-hidden="true">→</span>
						<span class="visually-hidden">(opens in new tab)</span>
					</a>
					<a href="/services" class="font-mono text-[13px] fg-accent no-underline hover:underline">
						See all services
					</a>
				</div>
			</section>

			<SiteFooter />
		</div>
	</main>
</Layout>
