---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import { PageHeader } from '@/components';
import { site } from '@/config';
import { series as pageMeta } from '@/config/pages';
import { PAGE_SIZE } from '@/utils/articles';

export async function getStaticPaths() {
	const allSeries = await getCollection('series');
	const allArticles = await getCollection('articles');
	const allVideos = await getCollection('videos');

	const enrichedSeries = allSeries
		.map((s) => {
			const articleCount = allArticles.filter((a) => a.data.series?.id === s.id).length;
			const videoCount = allVideos.filter((v) => v.data.series?.id === s.id).length;
			return {
				...s,
				count: articleCount + videoCount,
			};
		})
		.sort((a, b) => b.count - a.count);

	const totalPages = Math.ceil(enrichedSeries.length / PAGE_SIZE);

	return Array.from({ length: totalPages - 1 }, (_, i) => {
		const page = i + 2;
		const items = enrichedSeries.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);
		return {
			params: { page: String(page) },
			props: { items, currentPage: page, totalPages, total: enrichedSeries.length },
		};
	});
}

const { items, currentPage, totalPages, total } = Astro.props;

const seriesSchema = {
	'@context': 'https://schema.org',
	'@type': 'ItemList',
	name: `Content Series by ${site.author} — Page ${currentPage}`,
	url: `${site.url}/series/page/${currentPage}`,
	description: pageMeta.description,
	numberOfItems: total,
};
---

<Layout
	title={`${pageMeta.title} — Page ${currentPage}`}
	description={pageMeta.description}
	jsonLd={seriesSchema}
>
	<PageHeader
		prompt={`$ ls series/ --page ${currentPage}`}
		title="Series"
		subtitle={`Deep dives into PHP, Laravel, and API design. ${total} content series available.`}
	/>

	<section aria-label="Series" class="px-section py-10 border-b border-edge">
		<div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
			{
				items.map((series) => (
					<article class="flex flex-col rounded-2xl border border-edge bg-surface overflow-hidden group">
						<div class="flex flex-col flex-1 p-6 gap-3">
							<div class="flex items-center justify-between gap-2">
								<span class="font-mono text-[10px] uppercase tracking-[0.08em] fg-accent font-semibold">
									Series
								</span>
								<span class="font-mono text-[11px] fg-weak">{series.count} items</span>
							</div>
							<h2 class="text-[18px] font-bold fg-strong leading-tight group-hover:fg-accent transition-colors">
								<a href={`/series/${series.id}`} class="no-underline">
									{series.data.title}
								</a>
							</h2>
							{series.data.description && (
								<p class="text-[14px] fg leading-relaxed line-clamp-3">{series.data.description}</p>
							)}
							<div class="mt-auto pt-4 border-t border-edge-weak">
								<a
									href={`/series/${series.id}`}
									class="inline-flex items-center gap-1.5 font-mono text-[12px] font-semibold fg-accent no-underline hover:underline"
								>
									Explore series
									<span aria-hidden="true">→</span>
								</a>
							</div>
						</div>
					</article>
				))
			}
		</div>
	</section>

	<nav
		aria-label="Series pagination"
		class="flex items-center justify-between gap-4 px-section py-5 border-b border-edge flex-wrap"
	>
		<span class="font-mono text-[12px] fg-weak">Page {currentPage} of {totalPages}</span>
		<div class="flex items-center gap-4">
			{
				currentPage > 2 ? (
					<a
						href={`/series/page/${currentPage - 1}`}
						class="font-mono text-[12px] fg-accent no-underline hover:underline"
					>
						← Previous
					</a>
				) : (
					<a href="/series" class="font-mono text-[12px] fg-accent no-underline hover:underline">
						← Previous
					</a>
				)
			}
			{
				currentPage < totalPages && (
					<a
						href={`/series/page/${currentPage + 1}`}
						class="font-mono text-[12px] fg-accent no-underline hover:underline"
					>
						Next →
					</a>
				)
			}
		</div>
	</nav>
</Layout>
