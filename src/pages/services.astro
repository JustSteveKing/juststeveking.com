---
import Layout from '@/layouts/Layout.astro';
import { SiteHeader, SiteFooter, PageHeader } from '@/components';
import { services as pageMeta } from '@/config/pages';
import { site } from '@/config';

const servicesSchema = {
	'@context': 'https://schema.org',
	'@type': 'ProfessionalService',
	name: `Consulting Services — ${site.author}`,
	url: `${site.url}/services`,
	description: pageMeta.description,
	provider: { '@type': 'Person', name: site.author, url: site.url },
};

const offerings = [
	{
		id: 'api-audit',
		prompt: '$ analyze --scope=full',
		title: 'API Audit',
		badge: 'Most requested',
		tagline: 'Find and fix what\'s slowing down your API.',
		description: 'A structured diagnostic covering design consistency, performance bottlenecks, error handling, auth patterns, and documentation gaps. You get a prioritised report with clear, actionable recommendations — not a list of opinions.',
		deliverables: [
			'Written report with severity tiers',
			'Prioritised fix list with effort estimates',
			'Architecture recommendations for failure points',
			'Recorded debrief walkthrough',
		],
		goodFor: 'Teams with a production API that has reliability or performance problems.',
		duration: '1–2 weeks',
	},
	{
		id: 'api-design',
		prompt: '$ design --from-scratch',
		title: 'API Architecture',
		tagline: 'Get the design right before it\'s expensive to change.',
		description: 'Collaborative API design from resource modelling and versioning strategy through to auth patterns and error contracts. Delivered as a spec your team can build from with confidence.',
		deliverables: [
			'OpenAPI specification',
			'Design rationale and decision log',
			'Versioning and deprecation strategy',
			'Team review sessions',
		],
		goodFor: 'Teams starting a new API or refactoring before a major release.',
		duration: '2–4 weeks',
	},
	{
		id: 'leadership',
		prompt: '$ gh team --advise',
		title: 'Engineering Leadership',
		tagline: 'Practical support for managers and technical leads.',
		description: 'Ongoing advisory support covering career frameworks, 1:1 structures, performance calibration, hiring, and team health. Regular sessions, async access, and practical tooling including the engineering career framework.',
		deliverables: [
			'Bi-weekly advisory sessions',
			'Career framework setup and calibration',
			'Hiring process review',
			'Async support between sessions',
		],
		goodFor: 'Engineering managers, tech leads stepping up, or founders building their first eng team.',
		duration: 'Monthly retainer',
	},
	{
		id: 'discovery',
		prompt: '$ assess --scope=targeted',
		title: 'Technical Discovery',
		tagline: 'Expert input on a specific decision or risk, fast.',
		description: 'A focused short-term engagement for a specific technical challenge — architecture decision, stack choice, scaling concern, or incident post-mortem. Outside perspective, quickly, without a long commitment.',
		deliverables: [
			'Options assessment with trade-offs',
			'Recommended path with written rationale',
			'2 × working sessions',
			'Summary document',
		],
		goodFor: 'Teams at a technical crossroads who need a senior perspective quickly.',
		duration: '3–5 days',
	},
];

const process = [
	{ step: '01', title: 'Discovery call', desc: '30 minutes, no charge. We figure out whether there\'s a fit and what the right engagement looks like.' },
	{ step: '02', title: 'Scoped proposal', desc: 'A clear written proposal: scope, deliverables, timeline, and cost. No surprises.' },
	{ step: '03', title: 'Engagement', desc: 'Focused work with regular check-ins. You have direct access throughout — no account managers in the way.' },
	{ step: '04', title: 'Delivery + debrief', desc: 'Written deliverables and a recorded walkthrough so your whole team can reference the outcome.' },
];
---

<Layout {...pageMeta} jsonLd={servicesSchema}>
	<main id="main-content" class="landing">
		<div class="landing-container">
			<SiteHeader />

			<PageHeader
				prompt="$ cat services.md"
				title="Services"
				subtitle="Practical API consulting and engineering leadership support for SaaS teams. No retainers you don't need, no deliverables that gather dust."
			/>

			<section class="px-section py-12 border-b border-edge" aria-label="Service offerings">
				<div class="grid gap-6 sm:grid-cols-2">
					{offerings.map(service => (
						<article class="flex flex-col rounded-2xl border border-edge bg-surface overflow-hidden">
							<div class="px-6 py-5 border-b border-edge-weak bg-surface-weak">
								<p class="font-mono text-[11px] fg-weak mb-2" aria-hidden="true">{service.prompt}</p>
								<div class="flex items-center gap-2 flex-wrap">
									<h2 class="text-base font-bold fg-strong">{service.title}</h2>
									{service.badge && (
										<span class="font-mono text-[10px] font-bold fg-accent border border-accent rounded-[3px] px-1.5 py-0.5 uppercase tracking-[0.08em]">{service.badge}</span>
									)}
								</div>
								<p class="mt-1 text-[13px] fg leading-snug">{service.tagline}</p>
							</div>

							<div class="flex flex-col flex-1 px-6 py-5 gap-5">
								<p class="text-sm fg leading-relaxed">{service.description}</p>

								<div>
									<p class="font-mono text-[10px] uppercase tracking-[0.1em] fg-accent font-semibold mb-2">Deliverables</p>
									<ul class="list-none p-0 m-0 flex flex-col gap-1.5">
										{service.deliverables.map(d => (
											<li class="flex items-start gap-2 text-[13px] fg">
												<span class="font-mono fg-accent shrink-0 mt-px">›</span>
												<span>{d}</span>
											</li>
										))}
									</ul>
								</div>

								<div class="mt-auto pt-4 border-t border-edge-weak flex items-center justify-between gap-4 flex-wrap">
									<p class="text-[12px] fg-weak italic max-w-[32ch]">{service.goodFor}</p>
									<span class="font-mono text-[11px] fg-weak border border-edge rounded-[3px] px-2 py-1 shrink-0">{service.duration}</span>
								</div>
							</div>
						</article>
					))}
				</div>
			</section>

			<section class="px-section py-12 border-b border-edge" aria-label="How it works">
				<p class="font-mono text-[11px] uppercase tracking-[0.1em] fg-weak mb-6">How it works</p>
				<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
					{process.map(step => (
						<div class="flex flex-col gap-2">
							<span class="font-mono text-[28px] font-bold fg-accent leading-none">{step.step}</span>
							<h3 class="text-sm font-semibold fg-strong">{step.title}</h3>
							<p class="text-[13px] fg leading-relaxed">{step.desc}</p>
						</div>
					))}
				</div>
			</section>

			<section class="px-section py-12" aria-label="Get in touch">
				<h2 class="text-2xl font-bold tracking-tight fg-strong mb-3">Ready to get started?</h2>
				<p class="fg max-w-[52ch] leading-relaxed mb-8">
					Start with a free 30-minute discovery call. We'll work out what you need, whether there's a fit, and what the right shape of engagement looks like.
				</p>
				<div class="flex flex-wrap items-center gap-3">
					<a
						href="https://juststeveking.link"
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center gap-2 px-6 py-3 font-mono font-semibold text-sm rounded-lg bg-surface-strong fg-inverted no-underline transition-colors hover:opacity-90"
					>
						Book a discovery call
						<span aria-hidden="true">→</span>
					</a>
					<a
						href="/about"
						class="inline-flex items-center gap-2 px-6 py-3 font-mono font-semibold text-sm rounded-lg border border-edge fg-strong no-underline transition-colors hover:border-accent hover:fg-accent"
					>
						Learn more about me
					</a>
				</div>
			</section>

			<SiteFooter />
		</div>
	</main>
</Layout>
