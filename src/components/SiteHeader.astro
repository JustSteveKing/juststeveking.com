---
import { navLinks } from "@/config";
import Search from './Search.svelte';

const pathname = Astro.url.pathname;

function isCurrent(href: string): boolean {
	if (href.startsWith('http')) return false;
	if (href === '/') return pathname === '/';
	return pathname === href || pathname.startsWith(`${href}/`);
}
---

<header class="landing-header" role="banner">
	<a href="/" class="landing-logo" aria-label="juststeveking — home">
		<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
			<rect x="2" y="3" width="20" height="18" fill="currentColor"></rect>
			<rect x="5" y="7" width="2" height="10" fill="hsl(0, 20%, 99%)"></rect>
			<rect x="9" y="7" width="8" height="2" fill="hsl(0, 20%, 99%)"></rect>
			<rect x="9" y="11" width="6" height="2" fill="hsl(0, 20%, 99%)"></rect>
		</svg>
		<span>juststeveking</span>
	</a>

	<button
			class="mobile-menu-btn"
			aria-label="Open navigation menu"
			aria-expanded="false"
			aria-controls="landing-mobile-nav"
			aria-haspopup="true"
		>
		<svg class="menu-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
			<rect x="5" y="8" width="14" height="2"></rect>
			<rect x="5" y="14" width="14" height="2"></rect>
		</svg>
		<svg class="close-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
			<rect x="5" y="11" width="14" height="2" transform="rotate(45 12 12)"></rect>
			<rect x="5" y="11" width="14" height="2" transform="rotate(-45 12 12)"></rect>
		</svg>
	</button>

	<nav class="landing-nav" aria-label="Main navigation">
		{navLinks.map(link => (
			<a
				href={link.href}
				{...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
				{...(isCurrent(link.href) ? { 'aria-current': 'page' } : {})}
			>
				{link.label}
				{link.external && <span class="visually-hidden">(opens in new tab)</span>}
			</a>
		))}
		<Search client:load />
	</nav>
</header>

<nav
	class="mobile-nav"
	id="landing-mobile-nav"
	aria-label="Mobile navigation"
	aria-hidden="true"
	inert
>
	{navLinks.map(link => (
		<a
			href={link.href}
			{...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
			{...(isCurrent(link.href) ? { 'aria-current': 'page' } : {})}
		>
			{link.label}
			{link.external && <span class="visually-hidden">(opens in new tab)</span>}
		</a>
	))}
</nav>

<script>
	const menuBtn = document.querySelector<HTMLButtonElement>('.mobile-menu-btn');
	const mobileNav = document.querySelector<HTMLElement>('.mobile-nav');

	function openMenu(): void {
		document.body.classList.add('mobile-nav-open');
		menuBtn?.setAttribute('aria-expanded', 'true');
		menuBtn?.setAttribute('aria-label', 'Close navigation menu');
		mobileNav?.removeAttribute('aria-hidden');
		mobileNav?.removeAttribute('inert');
	}

	function closeMenu(): void {
		document.body.classList.remove('mobile-nav-open');
		menuBtn?.setAttribute('aria-expanded', 'false');
		menuBtn?.setAttribute('aria-label', 'Open navigation menu');
		mobileNav?.setAttribute('aria-hidden', 'true');
		mobileNav?.setAttribute('inert', '');
	}

	menuBtn?.addEventListener('click', () => {
		document.body.classList.contains('mobile-nav-open') ? closeMenu() : openMenu();
	});

	document.addEventListener('keydown', (e: KeyboardEvent) => {
		if (e.key === 'Escape' && document.body.classList.contains('mobile-nav-open')) closeMenu();
	});

	mobileNav?.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));
</script>
