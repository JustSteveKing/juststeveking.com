---
import { navLinks } from "@/config";
import Search from './Search.svelte';
import Logo from "./Logo.astro";

const pathname = Astro.url.pathname;

function isCurrent(href: string): boolean {
	if (href.startsWith('http')) return false;
	if (href === '/') return pathname === '/';
	return pathname === href || pathname.startsWith(`${href}/`);
}
---

<header class="sticky top-0 z-[100] bg-surface flex items-center justify-between px-section py-4 sm:py-6 border-b border-edge" role="banner">
	<a href="/" class="flex items-center gap-1.5 font-bold text-base text-text-strong no-underline hover:no-underline" aria-label="juststeveking — home">
		<Logo class="size-8 text-text-strong" />
	</a>

	<button
			class="flex min-[901px]:hidden items-center justify-center w-10 h-10 p-0 bg-transparent border-none text-text-strong cursor-pointer order-1 ml-auto mobile-menu-btn"
			aria-label="Open navigation menu"
			aria-expanded="false"
			aria-controls="landing-mobile-nav"
			aria-haspopup="true"
		>
		<svg class="menu-icon block w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
			<rect x="5" y="8" width="14" height="2"></rect>
			<rect x="5" y="14" width="14" height="2"></rect>
		</svg>
		<svg class="close-icon hidden w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
			<rect x="5" y="11" width="14" height="2" transform="rotate(45 12 12)"></rect>
			<rect x="5" y="11" width="14" height="2" transform="rotate(-45 12 12)"></rect>
		</svg>
	</button>

	<nav class="hidden min-[901px]:flex items-center gap-[var(--nav-gap)]" aria-label="Main navigation">
		{navLinks.map(link => (
			<a
				href={link.href}
				class="text-text-strong text-sm border-b border-transparent hover:no-underline hover:border-current aria-[current=page]:border-current"
				{...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
				{...(isCurrent(link.href) ? { 'aria-current': 'page' } : {})}
			>
				{link.label}
				{link.external && <span class="visually-hidden">(opens in new tab)</span>}
			</a>
		))}
		<Search client:load />
	</nav>
</header>

<nav
	class="fixed top-[var(--header-height)] inset-x-0 bottom-0 bg-surface z-[99] px-section py-8 flex flex-col gap-4 opacity-0 invisible transition-all duration-200 min-[901px]:hidden mobile-nav"
	id="landing-mobile-nav"
	aria-label="Mobile navigation"
	aria-hidden="true"
	inert
>
	{navLinks.map(link => (
		<a
			href={link.href}
			class="text-text-strong text-base py-2 no-underline"
			{...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
			{...(isCurrent(link.href) ? { 'aria-current': 'page' } : {})}
		>
			{link.label}
			{link.external && <span class="visually-hidden">(opens in new tab)</span>}
		</a>
	))}
</nav>

<style>
	:global(.mobile-nav-open) .menu-icon { display: none; }
	:global(.mobile-nav-open) .close-icon { display: block !important; }
	:global(.mobile-nav-open) .mobile-nav {
		opacity: 1 !important;
		visibility: visible !important;
	}
</style>

<script>
	const menuBtn = document.querySelector<HTMLButtonElement>('.mobile-menu-btn');
	const mobileNav = document.querySelector<HTMLElement>('.mobile-nav');

	function openMenu(): void {
		document.body.classList.add('mobile-nav-open');
		menuBtn?.setAttribute('aria-expanded', 'true');
		menuBtn?.setAttribute('aria-label', 'Close navigation menu');
		mobileNav?.removeAttribute('aria-hidden');
		mobileNav?.removeAttribute('inert');
	}

	function closeMenu(): void {
		document.body.classList.remove('mobile-nav-open');
		menuBtn?.setAttribute('aria-expanded', 'false');
		menuBtn?.setAttribute('aria-label', 'Open navigation menu');
		mobileNav?.setAttribute('aria-hidden', 'true');
		mobileNav?.setAttribute('inert', '');
	}

	menuBtn?.addEventListener('click', () => {
		document.body.classList.contains('mobile-nav-open') ? closeMenu() : openMenu();
	});

	document.addEventListener('keydown', (e: KeyboardEvent) => {
		if (e.key === 'Escape' && document.body.classList.contains('mobile-nav-open')) closeMenu();
	});

	mobileNav?.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));
</script>
