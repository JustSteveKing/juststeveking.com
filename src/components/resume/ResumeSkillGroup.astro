---
import type { ResumeSkill } from '@/types';

interface Props {
	skill: ResumeSkill;
}

const { skill } = Astro.props;
---

<div class="py-[22px] px-section border-b border-edge-weak last:border-b-0">
	<div class="flex justify-between items-baseline gap-3 mb-2.5">
		<span class="text-sm font-semibold fg-strong">{skill.name}</span>
		<span class="font-mono text-[10px] fg-accent uppercase tracking-[0.08em] font-semibold shrink-0"
			>{skill.level}</span
		>
	</div>
	{
		skill.keywords && skill.keywords.length > 0 && (
			<div class="flex flex-wrap gap-1.5">
				{skill.keywords.map((k) => (
					<span class="text-[12px] fg bg-surface-weak border border-edge-weak rounded-[3px] px-2 py-0.5">
						{k}
					</span>
				))}
			</div>
		)
	}
</div>
