---
import type { Level } from '@/data/career-framework';

interface Props {
	level: Level;
	index?: number;
}

const { level, index = 0 } = Astro.props as Props;

const trackColor = level.track === 'ic' ? 'var(--color-track-ic)' : 'var(--color-track-mgr)';
const headerGradient = `background: linear-gradient(to bottom, color-mix(in oklab, ${trackColor} 10%, transparent), transparent);`;
---

<article id={level.id} data-level-section="true" class="scroll-mt-24">
	<div class="rounded-2xl border border-edge p-4 pb-5" style={headerGradient}>
		<div class="flex items-center gap-2">
			<span class="w-2 h-2 rounded-full shrink-0" style={`background-color: ${trackColor};`}></span>
			<p
				class="font-mono text-[11px] font-bold uppercase tracking-[0.08em] m-0"
				style={`color: ${trackColor};`}
			>
				{level.shortTitle}
			</p>
		</div>
		<h3 class="mt-2 text-[1.1rem] font-bold tracking-tight fg-strong">{level.title}</h3>
		{
			level.timeToNext && (
				<p class="mt-1 font-mono text-[0.6rem] uppercase tracking-[0.1em] fg-weak">
					{level.timeToNext}
				</p>
			)
		}
	</div>

	<div class="mt-3 rounded-2xl border border-edge bg-surface p-6">
		<p class="text-sm leading-relaxed fg-weak">{level.summary}</p>

		{
			level.note && (
				<div class="mt-4 rounded-lg bg-surface-weak p-3">
					<p class="text-xs leading-relaxed fg-weak italic">{level.note}</p>
				</div>
			)
		}

		<div class="mt-6 grid gap-8 lg:grid-cols-2">
			<div>
				<h4
					class="font-mono text-[0.6rem] font-bold uppercase tracking-[0.1em] mb-3"
					style={`color: ${trackColor};`}
				>
					Expected impact
				</h4>
				<ul class="list-none p-0 m-0 flex flex-col gap-3">
					{
						level.impact.map((item) => (
							<li class="flex items-start gap-3 text-sm fg-weak leading-relaxed">
								<span
									class="w-1.5 h-1.5 rounded-full shrink-0 mt-1.5"
									style={`background-color: ${trackColor};`}
									aria-hidden="true"
								/>
								<span>{item}</span>
							</li>
						))
					}
				</ul>
			</div>

			<div>
				<h4 class="font-mono text-[0.6rem] font-bold uppercase tracking-[0.1em] mb-3 fg-weak">
					Day-to-day scope
				</h4>
				<ul class="list-none p-0 m-0 flex flex-col gap-3">
					{
						level.activities.map((item) => (
							<li class="flex items-start gap-3 text-sm fg-weak leading-relaxed">
								<span
									class="w-3 h-px shrink-0 mt-[0.7rem] bg-[var(--color-border)]"
									aria-hidden="true"
								/>
								<span>{item}</span>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</div>
</article>
