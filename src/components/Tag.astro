---
interface Props {
	href?: string;
	class?: string;
}

const { href, class: className = '' } = Astro.props;

const base =
	'font-mono text-[11px] fg-weak bg-surface-weak border border-edge-weak rounded-[3px] px-2 py-0.5';
const interactive =
	'no-underline transition-colors hover:[border-color:var(--color-accent)] hover:[color:var(--color-accent)]';
---

{
	href ? (
		<a href={href} class:list={[base, interactive, className]}>
			<slot />
		</a>
	) : (
		<span class:list={[base, className]}>
			<slot />
		</span>
	)
}
